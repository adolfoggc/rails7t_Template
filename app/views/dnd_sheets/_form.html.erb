<%= form_with(model: dnd_sheet, class: "contents") do |form| %>
  <% if dnd_sheet.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(dnd_sheet.errors.count, "error") %> prohibited this dnd_sheet from being saved:</h2>

      <ul class="list-disc ml-6">
        <% dnd_sheet.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": dnd_sheet.errors[:name].none?, "border-red-400 focus:outline-red-600": dnd_sheet.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :folk %>
    <%= form.number_field :folk, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": dnd_sheet.errors[:folk].none?, "border-red-400 focus:outline-red-600": dnd_sheet.errors[:folk].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :gender %>
    <%= form.number_field :gender, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": dnd_sheet.errors[:gender].none?, "border-red-400 focus:outline-red-600": dnd_sheet.errors[:gender].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>

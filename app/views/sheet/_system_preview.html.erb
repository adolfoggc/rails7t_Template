<%# Partial rendered into the `dnd_frame` turbo frame. Expects local `system`. %>
<div class="system-preview">
  <% if system == 'dnd' %>
    <p>Você selecionou <strong>Dungeons & Dragons 5e</strong>.</p>
    <%= link_to 'Criar ficha DnD', new_dnd_sheet_path, class: 'btn btn--primary', data: { turbo_frame: 'dnd_frame' } %>
  <% elsif system.present? %>
    <p>Você selecionou <strong><%= system %></strong>. Ainda não existem opções para esse sistema.</p>
  <% else %>
    <p>Escolha um sistema acima para ver as opções.</p>
  <% end %>
</div>
